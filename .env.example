# 公開URL。candy-rain-store の AUTH_CANDY_RAIN_ID_ISSUER と完全に一致させる
ISSUER=http://localhost:8080
PORT=8080
# candy-rain-store と同じデータベース。本番では専用ロール idp_server で接続する
# （migrations/003_idp_server_role.sql。"User" は読み取りのみ）
DATABASE_URL=postgresql://user:pass@localhost:5432/candyrain

# candy-rain-store を登録するクライアント情報
# （クライアントを 1 つだけ登録するときの書き方。OIDC_CLIENTS と併用できる）
OIDC_CLIENT_ID=candy-rain-store
OIDC_CLIENT_SECRET=replace-with-a-random-secret
# カンマ区切りで複数可
OIDC_REDIRECT_URIS=http://localhost:3000/api/auth/callback/candy-rain-id
OIDC_POST_LOGOUT_REDIRECT_URIS=http://localhost:3000/signout

# 追加のクライアント（JSON 配列）。candy-rain-stores は candy-rain-store と同時に
# 動かせるよう 3001 番ポートにしている
OIDC_CLIENTS='[{"id":"candy-rain-stores","secret":"replace-with-another-random-secret","redirect_uris":["http://localhost:3001/api/auth/callback/candy-rain-id"],"post_logout_redirect_uris":["http://localhost:3001/"]}]'

# 本番では必ず設定（未設定だと起動ごとに一時的な値が作られる）
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
SIGNING_KEY_PEM=
# 32文字以上。openssl rand -base64 48
SESSION_SECRET=

# ログイン画面の下に表示する補足（任意）
LOGIN_HINT=デモ: user1@mail.com / demo-password

# クライアントの IP アドレスが入るヘッダー（ログイン試行回数の制限に使う）。
# Vercel 上では未設定でも X-Real-IP を使う。前段のプロキシが上書きするヘッダーだけを指定する
# CLIENT_IP_HEADER=X-Real-IP
